{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/7tage",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/7tage/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Branding",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Branding/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/branding",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/branding/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dvm",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dvm/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/checkliste",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/checkliste/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/websitecheck",
      "destination": "/webseitencheck",
      "permanent": false
    },
    {
      "source": "/website-check",
      "destination": "/webseitencheck",
      "permanent": false
    },
    {
      "source": "/webseiten-check",
      "destination": "/webseitencheck",
      "permanent": false
    },
    {
      "source": "/Webseitencheck",
      "destination": "/webseitencheck",
      "permanent": false
    }
  ],
  "functions": {
    "api/check.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/wc-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|favicon-16.png|favicon-32.png|apple-touch-icon.png|icon-192.png|icon-512.png|og.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}